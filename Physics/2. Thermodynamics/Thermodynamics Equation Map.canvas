{
	"nodes":[
		{"id":"root","type":"text","text":"Temperature measures energy per particle. Equal $T$ means equilibrium. A bare $T$ is in kelvins.\n\n[[2.1.3 Zeroth Law of Thermodynamics|Zeroth law]], [[2.2.1 Absolute Temperature|absolute temperature]]","x":520,"y":0,"width":940,"height":130,"color":"5"},
		{"id":"boltz","type":"text","text":"Boltzmann factor\n$$e^{-E/kT}$$\n[[2.3.3 Maxwell Speed Distribution]]","x":0,"y":0,"width":420,"height":150,"color":"5"},
		{"id":"maxwell","type":"text","text":"$$f(v) \\propto v^2 e^{-mv^2/2kT}$$\n$$v_{\\text{rms}} = \\sqrt{3kT/m}$$\n[[2.3.3 Maxwell Speed Distribution|Maxwell]], [[2.3.2 Root-Mean-Square Speed|rms speed]]","x":0,"y":280,"width":420,"height":190,"color":"5"},
		{"id":"ke","type":"text","text":"$$\\tfrac{1}{2} m \\overline{v^2} = \\tfrac{3}{2} kT$$\n[[2.3.1 Molecular Interpretation of Temperature]]","x":520,"y":280,"width":420,"height":150,"color":"5"},
		{"id":"expand","type":"text","text":"$$\\Delta L = \\alpha L_0\\, \\Delta T, \\qquad \\beta = 3\\alpha$$\n[[2.1.4 Thermal Expansion]]","x":1560,"y":280,"width":420,"height":150,"color":"5"},
		{"id":"pv","type":"text","text":"$$PV = NkT$$\n[[2.2.3 Ideal Gas Law]]","x":520,"y":560,"width":420,"height":150,"color":"5"},
		{"id":"equi","type":"text","text":"$$E_{\\text{int}} = \\tfrac{d}{2} NkT$$\n[[2.3.4 Equipartition of Energy]]","x":1040,"y":560,"width":420,"height":150,"color":"5"},
		{"id":"work","type":"text","text":"$$W = \\int P\\, dV$$\nArea under the path.\n[[2.5.1 Thermodynamic Work]]","x":0,"y":840,"width":420,"height":170,"color":"4"},
		{"id":"first","type":"text","text":"$$\\Delta E_{\\text{int}} = Q - W$$\n[[2.5.2 First Law of Thermodynamics]]","x":520,"y":840,"width":420,"height":150,"color":"4"},
		{"id":"heat","type":"text","text":"$$Q = mc\\, \\Delta T, \\qquad Q = mL$$\n[[2.4.3 Specific Heat]], [[2.4.4 Latent Heat]]","x":1040,"y":840,"width":420,"height":150,"color":"4"},
		{"id":"transfer","type":"text","text":"$$\\frac{dQ}{dt} = kA \\frac{\\Delta T}{L}$$\n$$\\frac{dQ}{dt} = \\varepsilon \\sigma A T^4$$\n[[2.6.1 Thermal Conduction|Conduction]], [[2.6.3 Thermal Radiation|radiation]]","x":1560,"y":840,"width":420,"height":230,"color":"4"},
		{"id":"caps","type":"text","text":"$$C_V = \\tfrac{d}{2} R, \\qquad C_P = C_V + R$$\n$$\\gamma = 1 + \\tfrac{2}{d}$$\n[[2.5.4 Molar Specific Heats]]","x":0,"y":1140,"width":420,"height":190,"color":"4"},
		{"id":"proc","type":"text","text":"[[2.5.3a Isovolumetric Process|Isovolumetric]]: $W = 0$\n\n[[2.5.3b Isobaric Process|Isobaric]]: $W = P\\, \\Delta V$\n\n[[2.5.3c Isothermal Process|Isothermal]]: $Q = W = NkT \\ln(V_2/V_1)$\n\n[[2.5.3d Adiabatic Process|Adiabatic]]: $Q = 0$, $PV^{\\gamma} = \\text{const}$","x":520,"y":1140,"width":420,"height":230,"color":"4"},
		{"id":"calor","type":"text","text":"$$\\sum_i Q_i = 0$$\n[[2.4.5 Calorimetry]]","x":1040,"y":1140,"width":420,"height":150,"color":"4"},
		{"id":"cycle","type":"text","text":"$$\\Delta E_{\\text{cycle}} = 0$$\n$$W = Q_H - Q_L, \\qquad e = 1 - \\frac{Q_L}{Q_H}$$\n[[2.7.1 Heat Engine]]","x":520,"y":1460,"width":420,"height":200,"color":"4"},
		{"id":"entropy","type":"text","text":"$$dS = \\frac{dQ}{T}$$\nOn a reversible path.\n[[2.7.6 Entropy]]","x":1040,"y":1460,"width":420,"height":180,"color":"1"},
		{"id":"dsgas","type":"text","text":"$$\\Delta S = \\tfrac{d}{2} Nk \\ln\\frac{T_2}{T_1} + Nk \\ln\\frac{V_2}{V_1}$$\n[[2.7.6 Entropy]]","x":1560,"y":1460,"width":500,"height":150,"color":"1"},
		{"id":"otto","type":"text","text":"Otto cycle\n$$e = 1 - r^{1-\\gamma}, \\qquad r = V_{\\max}/V_{\\min}$$\n[[2.7.4a Otto Cycle]]","x":0,"y":1760,"width":420,"height":160,"color":"1"},
		{"id":"carnot","type":"text","text":"Carnot cycle (reversible)\n$$e_C = 1 - \\frac{T_L}{T_H}$$\nEvery engine between $T_H$ and $T_L$ has $e \\leq e_C$.\n[[2.7.4b Carnot Engine]]","x":520,"y":1760,"width":420,"height":200,"color":"1"},
		{"id":"total","type":"text","text":"$$\\Delta S_{\\text{sys}} + \\Delta S_{\\text{env}} \\geq 0$$\nEqual to zero only if reversible.\n[[2.7.7 Entropy Statement of the Second Law]]","x":1040,"y":1760,"width":420,"height":180,"color":"1"},
		{"id":"cop","type":"text","text":"Refrigerator\n$$\\text{COP} = \\frac{Q_L}{W} \\leq \\frac{T_L}{T_H - T_L}$$\nHeat pump\n$$\\text{COP}_{\\text{hp}} = \\frac{Q_H}{W}$$\n[[2.7.5a Refrigerator]], [[2.7.5b Heat Pump]]","x":520,"y":2100,"width":420,"height":260,"color":"1"},
		{"id":"claus","type":"text","text":"Heat flows from hot to cold on its own. No engine has $e = 1$.\n\n[[2.7.2 Second Law of Thermodynamics]]","x":1040,"y":2100,"width":420,"height":150,"color":"1"},
		{"id":"leg1","type":"text","text":"Kinetic theory, 2.1 to 2.3","x":1560,"y":1800,"width":360,"height":60,"color":"5"},
		{"id":"leg2","type":"text","text":"First law and heat, 2.4 to 2.6","x":1560,"y":1880,"width":360,"height":60,"color":"4"},
		{"id":"leg3","type":"text","text":"Second law, 2.7","x":1560,"y":1960,"width":360,"height":60,"color":"1"}
	],
